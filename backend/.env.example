APP_NAME=RushPlay API
ENV=development
PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rushplay
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# Durée de session. Le cookie du site suit cette valeur. 60 = déconnecté toutes les heures ;
# 10080 = sept jours, ce que le site vise (le cookie est httpOnly, aucun renouvellement n'existe).
JWT_EXPIRE_MINUTES=10080
CRON_SECRET=change-me-cron
CORS_ORIGINS=http://localhost:3000
THE_ODDS_API_KEY=
FOOTBALL_DATA_ORG_KEY=
FD_UK_BASE_URL=https://www.football-data.co.uk/mmz4281

# --- Stripe ---
#
# Tant que ces trois valeurs sont absentes, l'abonnement n'est pas ouvert au
# paiement : /billing/checkout et /billing/webhook repondent 503 plutot que
# d'accepter une commande qui n'aboutira jamais.
#
# STRIPE_SECRET_KEY    : cle secrete (sk_live_... en production, sk_test_... pour essayer)
# STRIPE_WEBHOOK_SECRET: secret du endpoint webhook (whsec_...), donne par Stripe
#                        a la creation du webhook. C'est LUI qui distingue un
#                        paiement d'une requete HTTP quelconque.
# STRIPE_PRICE_ID      : identifiant du tarif recurrent (price_...). Le montant
#                        n'est ecrit nulle part dans le code : il est lu ici.
# PUBLIC_SITE_URL      : ou Stripe renvoie l'utilisateur apres paiement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PUBLIC_SITE_URL=http://localhost:3000
